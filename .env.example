# ---------------------------------------------------------------------------
# Multi-Channel Inventory Hub — environment configuration (12-factor)
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The dialect is selected by the URL scheme. Postgres is the reference target.
#   postgresql://user:pass@host:5432/dbname
#   mysql://user:pass@host:3306/dbname
#   file:./data/hub.db                      (SQLite)
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub

# Must match the DATABASE_URL scheme. Prisma cannot infer the provider at
# runtime, so migrations and client generation are selected from this value.
# One of: postgresql | mysql | sqlite
DATABASE_PROVIDER=postgresql

# --- Redis / job queue -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# Run BullMQ workers inside the API process (default) or as a separate
# deployment. Set to false on the web tier when running dedicated workers.
RUN_WORKERS_IN_PROCESS=true

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin of this instance; used for cookies, OAuth callbacks, webhooks.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Security --------------------------------------------------------------
# 32-byte key, base64-encoded. Encrypts the connector credential store
# (AES-256-GCM). Losing this makes every stored channel credential unreadable.
#   openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# Signs session cookies. Rotating it logs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

SESSION_TTL_HOURS=720

# --- Authentication --------------------------------------------------------
# local = username + password. oidc = single sign-on against any OpenID Connect
# provider (Keycloak, Auth0, Entra, Google, ...) via standard discovery.
AUTH_PROVIDER=local

# Register this redirect URI with your provider — it is derived from APP_URL and
# is not configured separately:
#   ${APP_URL}/api/auth/oidc/callback
#
# The issuer base, without /.well-known/openid-configuration. Every endpoint in
# the discovery document must share this origin, or startup is refused: the
# token endpoint receives OIDC_CLIENT_SECRET.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# Optional. Name a claim carrying groups or roles and the provider becomes
# authoritative: the mapped role is reapplied on EVERY login, so removing
# someone from a group there takes effect here immediately.
# Leave unset to assign OIDC_DEFAULT_ROLE once at creation and manage roles here.
OIDC_ROLE_CLAIM=
OIDC_ROLE_MAP={"hub-admins":"admin","hub-staff":"editor"}
OIDC_DEFAULT_ROLE=viewer

# Keep password login working alongside SSO. On by default and worth leaving on
# until the SSO flow is proven: a mistyped redirect URI or a rotated client
# secret would otherwise lock you out of your own instance with no way back in.
# Only accounts that already have a password can use it — an SSO identity is
# provisioned without one, so it cannot be impersonated this way.
OIDC_ALLOW_LOCAL_LOGIN=true

# The first identity to sign in successfully on an instance with no users at all
# is provisioned as an admin, mirroring the first-run local setup. Without that
# an SSO-only deployment would have no way in.

# --- Optional features -----------------------------------------------------
# Admin-only, read-only SQL console (TECHNICAL_DESIGN.md §7). Off by default,
# and PostgreSQL only — its guarantee is a PostgreSQL READ ONLY transaction.
ENABLE_QUERY_CONSOLE=false

# Separate connection used exclusively by the console. The app refuses to start
# if the console is enabled without it, because pointing it at DATABASE_URL
# hands an admin a writable connection and removes the entire protection.
#
# Create the role first (as a superuser), granting SELECT and nothing else:
#
#   CREATE ROLE hub_readonly LOGIN PASSWORD 'choose-a-strong-one';
#   GRANT CONNECT ON DATABASE hub TO hub_readonly;
#   GRANT USAGE ON SCHEMA public TO hub_readonly;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO hub_readonly;
#   -- so tables added by future migrations are readable too:
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT ON TABLES TO hub_readonly;
#
# Nothing usable leaks through it: session tokens are stored as SHA-256 hashes,
# API keys as argon2id hashes, and channel credentials as AES-GCM ciphertext
# whose key is CREDENTIAL_MASTER_KEY above — held in the environment, not the
# database.
QUERY_CONSOLE_DATABASE_URL=

# --- Reconciliation --------------------------------------------------------
# Cron expression for the nightly ledger-vs-channel diff.
RECONCILE_CRON=0 3 * * *
