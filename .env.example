# ---------------------------------------------------------------------------
# Multi-Channel Inventory Hub — environment configuration (12-factor)
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The dialect is selected by the URL scheme. Postgres is the reference target.
#   postgresql://user:pass@host:5432/dbname
#   mysql://user:pass@host:3306/dbname
#   file:./data/hub.db                      (SQLite)
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub

# Must match the DATABASE_URL scheme. Prisma cannot infer the provider at
# runtime, so migrations and client generation are selected from this value.
# One of: postgresql | mysql | sqlite
DATABASE_PROVIDER=postgresql

# --- Redis / job queue -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# Run BullMQ workers inside the API process (default) or as a separate
# deployment. Set to false on the web tier when running dedicated workers.
RUN_WORKERS_IN_PROCESS=true

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin of this instance; used for cookies, OAuth callbacks, webhooks.
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Security --------------------------------------------------------------
# 32-byte key, base64-encoded. Encrypts the connector credential store
# (AES-256-GCM). Losing this makes every stored channel credential unreadable.
#   openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# Signs session cookies. Rotating it logs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

SESSION_TTL_HOURS=720

# --- Optional features -----------------------------------------------------
# Admin-only, read-only SQL console (TECHNICAL_DESIGN.md §7). Off by default.
ENABLE_QUERY_CONSOLE=false
# Separate read-only connection used exclusively by the query console.
QUERY_CONSOLE_DATABASE_URL=

# --- Reconciliation --------------------------------------------------------
# Cron expression for the nightly ledger-vs-channel diff.
RECONCILE_CRON=0 3 * * *
