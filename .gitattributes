# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary

pnpm-lock.yaml linguist-generated=true -diff
packages/db/prisma/migrations/** linguist-generated=true

# Marketplace export fixtures are byte-exact reproductions of real files, and
# their line endings are part of what they test: TCGPlayer's MyPricing export
# is CRLF while its PullSheet export is LF. Normalising them would quietly
# delete the difference the parser has to cope with.
packages/*/test/fixtures/*.csv -text
