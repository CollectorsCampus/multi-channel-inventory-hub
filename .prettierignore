# Prettier's default ignore list is only node_modules, so everything below has
# to be named explicitly.

# The lockfile is generated by pnpm, and pnpm's YAML output does not match
# Prettier's preferences. Formatting it means every dependency change needs a
# manual reformat on top — which is not a thing Dependabot can do, so every
# Dependabot PR failed `format:check` (the first step of the build job, and not
# covered by `pnpm lint`) on a file no human wrote. Reformatting it also makes
# the diff of a dependency bump unreadable.
pnpm-lock.yaml

# Build output and generated code. These are gitignored, so CI never sees them
# — but `format:check` runs over the working tree, so without this a local run
# after a build reports failures that CI cannot reproduce.
dist/
build/
coverage/
*.tsbuildinfo
packages/db/generated/

# Real marketplace exports (see .gitignore). Never read, never rewritten.
private/
