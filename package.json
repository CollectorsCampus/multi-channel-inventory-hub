{
  "name": "inventory-hub",
  "version": "0.10.0",
  "private": true,
  "description": "Self-hostable multi-channel inventory sync. Central ledger, pluggable channel connectors.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hub/db generate",
    "db:migrate": "pnpm --filter @hub/db migrate:dev",
    "db:studio": "pnpm --filter @hub/db studio",
    "db:seed": "pnpm --filter @hub/db seed"
  },
  "pnpm": {
    "overrides": {
      "find-my-way@9": "^9.7.0",
      "js-yaml@5": "^5.2.2",
      "fastify@5": "^5.11.3",
      "brace-expansion@1": "^1.1.17"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "prettier-plugin-prisma": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
