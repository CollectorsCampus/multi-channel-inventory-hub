{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests must not reach dist. src/testing.ts is the published contract suite
  // and does ship; *.spec.ts files are this package's own tests and do not.
  "exclude": ["src/**/*.spec.ts"]
}
