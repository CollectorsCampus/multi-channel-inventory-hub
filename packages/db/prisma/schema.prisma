// Multi-Channel Inventory Hub — canonical Prisma schema.
//
// NAMING: tables and columns are snake_case in the database, camelCase in the
// Prisma client. Every non-single-word field carries an explicit @map. This
// matters because the admin SQL console (TECHNICAL_DESIGN.md §7) exposes raw
// SQL to operators, and mixed-case identifiers would force them to quote every
// column ("quantityOnHand") on Postgres while behaving differently again on
// MySQL. Keep new fields consistent: add @map whenever a name is not a single
// lowercase word.
//
// PORTABILITY CONTRACT (Postgres reference; MySQL/MariaDB + SQLite must also work):
//   1. No `Json` columns.  NOT because SQLite cannot take them — Prisma 6.19+
//      accepts `Json` on all three providers — but because Json null semantics
//      diverge: the `Prisma.DbNull` vs `Prisma.JsonNull` distinction is
//      Postgres-only, so identical code silently behaves differently per
//      dialect.  JSON-bearing fields are `String`, serialized and parsed at the
//      service boundary via packages/db/src/json.ts.  TECHNICAL_DESIGN.md §3
//      already forbids querying into them, so nothing is lost.
//   2. No `enum` types.  Again not a hard limitation — Prisma maps enums to
//      TEXT on SQLite — but growing a native enum costs a migration that
//      rewrites data: Postgres needs ALTER TYPE, MySQL ENUM changes can rewrite
//      the whole table.  Closed value sets are `String`, validated at runtime by
//      packages/db/src/enums.ts, which is their single source of truth.
//   3. No nullable columns inside a @@unique that is meant to *prevent* duplicates.
//      NULL != NULL in unique indexes on all three dialects, so such a constraint
//      silently never fires.  Where a natural key needs an optional-looking field,
//      it is non-null with a sentinel default (see Sku.printing).
//   4. No dialect-specific native types, and no raw SQL in core query paths.
//
// CONCURRENCY: InventoryItem.version is an optimistic-locking token.  Prisma
// interactive transactions do NOT take row locks, and SQLite has no row locking
// at all, so `SELECT ... FOR UPDATE` is not a portable option.  All quantity
// mutations go through InventoryService, which reads the version, writes via
// `updateMany({ where: { id, version } })`, and retries when zero rows match.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// The abstract product: "Charizard — Base Set". Not sellable on its own.
model CatalogItem {
  id         String  @id @default(uuid(7))
  name       String
  /// Lower-cased copy of `name`, maintained on write and queried by the
  /// inventory browser's free-text filter.
  ///
  /// Exists because Prisma's `mode: "insensitive"` is a PostgreSQL-only filter:
  /// it does not compile for SQLite, and MySQL's behaviour depends on the
  /// column collation instead. Searching a pre-normalized column is the only
  /// way to get identical, case-insensitive matching on all three dialects
  /// without dialect-specific query code (§3).
  searchName String  @default("") @map("search_name")
  game       String? // "Magic", "Pokemon"; null for non-TCG goods
  setName    String? @map("set_name")
  imageUrl   String? @map("image_url")

  /// The printed collector number ("013/094", "EBP01-001"), where the source
  /// publishes one. Nullable and NOT part of any unique: numbers are unique
  /// only within a set, set names diverge between sources, and rule 4 bans
  /// nullable columns in duplicate-preventing uniques anyway. Its job is
  /// duplicate *detection* — the strongest cross-source signal two rows are
  /// one product — and titles, someday.
  collectorNumber String? @map("collector_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  externalRefs CatalogExternalRef[]
  skus         Sku[]
  marketPrices MarketPrice[]

  @@index([name])
  @@index([searchName])
  @@index([game, setName])
  @@map("catalog_items")
}

/// The latest market price this hub has fetched for one item, from one source,
/// for one printing — a foil's market is not the normal's.
///
/// Latest-only by design, not a history: each sweep overwrites in place,
/// keeping the previous figure in `previousPrice` so a change can be shown as
/// was/now. A price-history table needs its own retention story (the query
/// console precedent) and nothing reads one yet. This is deliberately separate
/// from CatalogItem itself, which stores identity only — "identity is durable,
/// prices are not" — the difference here is the explicit `fetchedAt` a caller
/// must confront.
model MarketPrice {
  id            String @id @default(uuid(7))
  catalogItemId String @map("catalog_item_id")
  /// CatalogSource key the figure came from ("tcgcsv", "scryfall").
  source        String
  /// Non-null by design: nullable would make the unique below unenforceable
  /// (NULL != NULL). "NORMAL" is the same sentinel Sku uses.
  printing      String @default("NORMAL")

  /// Cents, never a float.
  price         Int
  currency      String   @default("USD")
  /// What the same row held before this fetch, for was/now display.
  previousPrice Int?     @map("previous_price")
  fetchedAt     DateTime @map("fetched_at")

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, source, printing])
  @@map("market_prices")
}

/// Maps a CatalogItem onto a platform's canonical ID. We reuse external IDs
/// (notably TCGPlayer productId) rather than inventing our own catalog.
model CatalogExternalRef {
  id            String   @id @default(uuid(7))
  catalogItemId String   @map("catalog_item_id")
  source        String // CatalogSource: "tcgplayer" | "scryfall" | "shopify" | ...
  externalId    String   @map("external_id")
  createdAt     DateTime @default(now()) @map("created_at")

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([catalogItemId])
  @@map("catalog_external_refs")
}

/// The sellable unit: item + condition + printing + language.
model Sku {
  id            String   @id @default(uuid(7))
  catalogItemId String   @map("catalog_item_id")
  condition     String // SkuCondition: NM | LP | MP | HP | DMG | SEALED | NA
  /// Non-null by design: a nullable column in the natural key below would make
  /// the unique constraint unenforceable (NULL != NULL). "NORMAL" is the
  /// sentinel for "no special printing".
  printing      String   @default("NORMAL")
  language      String   @default("EN")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  catalogItem CatalogItem    @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  inventory   InventoryItem?

  @@unique([catalogItemId, condition, printing, language])
  @@index([catalogItemId])
  @@map("skus")
}

// ---------------------------------------------------------------------------
// Inventory ledger
// ---------------------------------------------------------------------------

/// One row per Sku; the root of the quantity ledger and the single source of truth.
///
/// INVARIANT: quantityOnHand >= SUM(fixed allocations' quantityAllocated) + reserveQuantity >= 0
///
/// This spans two tables, so no CHECK constraint can express it. It is enforced
/// in InventoryService inside a transaction, and audited by a scheduled
/// integrity job that reports violations alongside reconciliation.
model InventoryItem {
  id              String @id @default(uuid(7))
  skuId           String @unique @map("sku_id")
  /// Physical truth: how many units we actually possess.
  quantityOnHand  Int    @default(0) @map("quantity_on_hand")
  /// Held back from the pool before any pooled math — "never list the last N anywhere".
  reserveQuantity Int    @default(0) @map("reserve_quantity")
  /// Cents. Single scalar; cannot represent lots acquired at different prices.
  costBasis       Int?   @map("cost_basis")
  /// Optimistic-locking token. Incremented on every quantity mutation.
  version         Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sku         Sku                 @relation(fields: [skuId], references: [id], onDelete: Cascade)
  allocations ChannelAllocation[]
  movements   StockMovement[]

  @@map("inventory_items")
}

/// Append-only ledger of every change to quantityOnHand, whatever the cause.
/// Distinct from SyncEvent: this is the stock ledger, SyncEvent is the I/O log.
model StockMovement {
  id                String   @id @default(uuid(7))
  inventoryItemId   String   @map("inventory_item_id")
  /// Signed: +5 intake, -1 sale.
  delta             Int
  /// Value of quantityOnHand after this movement was applied.
  resultingOnHand   Int      @map("resulting_on_hand")
  reason            String // StockMovementReason: intake | sale | adjustment | return | reconcile | shrinkage
  channelInstanceId String?  @map("channel_instance_id")
  allocationId      String?  @map("allocation_id")
  /// Free-text note; for sales, the external order reference.
  note              String?
  actorUserId       String?  @map("actor_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
  @@index([reason, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Channels
// ---------------------------------------------------------------------------

/// A configured connection, e.g. "My Shopify Store", resolving to a connector plugin.
model ChannelInstance {
  id            String  @id @default(uuid(7))
  connectorKey  String  @map("connector_key") // resolves a registered connector: "shopify" | "tcgplayer"
  displayName   String  @map("display_name")
  /// JSON-encoded non-secret connector config, shaped by the connector's
  /// configSchema. Never contains credentials. String, not Json — see header.
  config        String  @default("{}")
  /// Points at Credential.ref. Null until the channel has been connected.
  credentialRef String? @map("credential_ref")

  enabled Boolean @default(true)

  /// Cursor for connectors whose inbound path is orders.poll rather than webhooks.
  lastPolledAt         DateTime? @map("last_polled_at")
  lastReconciledAt     DateTime? @map("last_reconciled_at")
  /// Opt-in: re-push our quantity when reconciliation finds the channel showing
  /// something else (§6). Defaults off, and only ever acts in that one
  /// direction — the ledger is never rewritten from a channel, so a platform
  /// that reports a wrong number cannot silently become the source of truth.
  reconcileAutoCorrect Boolean   @default(false) @map("reconcile_auto_correct")

  /// Opt-in: create a listing on this channel for stock as it is taken in,
  /// instead of waiting for the operator to select it on /list.
  ///
  /// Guarded by listingDefaults rather than standing alone. Creation applies
  /// tags, metafields and a category verbatim and the hub may never derive
  /// one — every collection on a real store is a tag equality rule, so a
  /// guessed tag yields a product that exists in the admin and appears
  /// nowhere in the shop, reported by nothing. With nothing declared there is
  /// no honest value to send, so the service refuses to enable this until
  /// listingDefaults says what a created product should carry.
  autoListNewStock Boolean @default(false) @map("auto_list_new_stock")

  /// Opt-in: when a single's advertised quantity is pushed to zero, ask the
  /// channel to unpublish (draft) the listing's product — only if the platform
  /// itself shows the whole product out of stock, so one sold-out condition
  /// cannot hide a sibling variant that still has copies. One direction only:
  /// restocking never re-activates automatically, because nothing should
  /// become buyable on a storefront because a background job ran.
  draftAtSellout Boolean @default(false) @map("draft_at_sellout")

  /// Opt-in: publish again when stock comes back — but only a listing this hub
  /// unpublished itself, which `ChannelAllocation.selloutDraftedAt` records.
  ///
  /// Off by default, and separately from draftAtSellout, because the two are
  /// different risks. Leaving a sold-out page up costs nothing; publishing
  /// something the operator deliberately held back is a decision they never
  /// made. The platform cannot say who drafted a product, so the hub's own
  /// stamp is the only honest answer to "was this ours to re-publish".
  reactivateOnRestock Boolean @default(false) @map("reactivate_on_restock")

  /// SelloutScope: "singles" | "all". What draftAtSellout applies to.
  ///
  /// Defaults to singles because sealed product is restocked far more often
  /// than a given card is: unpublishing a booster box that will be back next
  /// week churns the storefront for nothing, and re-publishing is a manual step
  /// by design. A shop that would rather hide everything it cannot sell says so
  /// here. An unrecognised value is read as "singles" — the conservative
  /// direction, since the cost of a typo should not be a storefront emptied of
  /// its sealed product.
  selloutScope String @default("singles") @map("sellout_scope")

  /// JSON-encoded repricing policy for this channel — condition percentages of
  /// market, rounding, floor, the auto-apply threshold. String, not Json, the
  /// same choice `listingDefaults` makes: read entire, written entire, never
  /// queried into. Deliberately its own column rather than folded into
  /// listingDefaults, whose presence gates autoListNewStock — a repricing
  /// policy is not a declaration of what a created product carries.
  repricingPolicy String @default("{}") @map("repricing_policy")

  /// JSON-encoded defaults applied to listings this channel creates:
  /// { tags?, metafields?, category?, vendor? }. String, not Json — see header.
  ///
  /// Values are the channel's own vocabulary and opaque to the core, which is
  /// exactly why they are stored wholesale and never queried into: no filter
  /// asks "which channels default to this tag". Read entire at creation and
  /// written entire from the settings form.
  listingDefaults String    @default("{}") @map("listing_defaults")
  /// ChannelHealth: unknown | ok | degraded | error
  healthStatus    String    @default("unknown") @map("health_status")
  healthCheckedAt DateTime? @map("health_checked_at")
  healthDetail    String?   @map("health_detail")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allocations   ChannelAllocation[]
  syncEvents    SyncEvent[]
  webhookEvents WebhookEvent[]
  alerts        Alert[]

  @@index([connectorKey])
  @@index([enabled])
  @@map("channel_instances")
}

/// Per-channel listing for one InventoryItem: allocation mode, quantity, price.
model ChannelAllocation {
  id                String @id @default(uuid(7))
  inventoryItemId   String @map("inventory_item_id")
  channelInstanceId String @map("channel_instance_id")

  /// AllocationMode: "fixed" | "pooled". See TECHNICAL_DESIGN.md §4.
  mode              String @default("pooled")
  /// fixed mode only: this channel's exclusive partition of stock.
  quantityAllocated Int?   @map("quantity_allocated")
  /// pooled mode only: optional cap. Null = mirror the whole pool.
  maxQuantity       Int?   @map("max_quantity")
  /// Cache of the quantity we last pushed / believe is live on the channel.
  /// In pooled mode this is derived, never truth — recomputed on every change.
  listedQuantity    Int    @default(0) @map("listed_quantity")

  /// Cents, channel-specific. Nullable: a draft allocation may not be priced yet.
  price    Int?
  currency String @default("USD")

  /// shopify variant/inventory-item id, tcgplayer sku listing id, ...
  externalListingId String? @map("external_listing_id")
  /// AllocationStatus: draft | listed | error | delisted
  status            String  @default("draft")

  lastPushedAt DateTime? @map("last_pushed_at")
  lastError    String?   @map("last_error")

  /// When the hub unpublished this listing because it sold out, or null.
  ///
  /// The permission slip for re-publishing it: a platform cannot say who
  /// drafted a product, so without this the restock path could not tell a
  /// listing the hub hid from one the operator hid on purpose — and
  /// re-publishing the second is a decision they never made. Cleared the moment
  /// it is used, so the permission is spent rather than standing.
  selloutDraftedAt DateTime? @map("sellout_drafted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  channelInstance ChannelInstance  @relation(fields: [channelInstanceId], references: [id], onDelete: Cascade)
  repriceProposal RepriceProposal?

  @@unique([inventoryItemId, channelInstanceId])
  /// Index, not unique: externalListingId is nullable, so a unique constraint
  /// would not enforce anything for unlisted rows. This is the hot lookup for
  /// the inbound sale path (external listing id -> allocation).
  @@index([channelInstanceId, externalListingId])
  @@index([status])
  @@index([inventoryItemId])
  @@map("channel_allocations")
}

/// A price change the sweep proposes but does not apply — the review queue for
/// moves larger than the channel's auto-apply threshold.
///
/// At most one per allocation, replaced by each sweep and **deleted on
/// decision** (applied or dismissed) rather than kept with a status: the
/// applied price is recorded where prices live (the allocation, and the sync
/// log when pushed), and a graveyard of decided rows would need its own
/// retention story. A dismissal therefore does not survive the next sweep —
/// the same market re-proposes the same change — which is honest: the market
/// still says what it says.
model RepriceProposal {
  id           String @id @default(uuid(7))
  allocationId String @map("allocation_id")

  /// Cents at proposal time; null for an allocation that had no price yet.
  currentPrice  Int?   @map("current_price")
  /// Cents — what the policy computed.
  proposedPrice Int    @map("proposed_price")
  /// Cents — the market figure the computation started from.
  marketPrice   Int    @map("market_price")
  /// CatalogSource key the market figure came from.
  source        String
  /// How the number was arrived at, in the operator's terms.
  basis         String

  createdAt DateTime @default(now()) @map("created_at")

  allocation ChannelAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@unique([allocationId])
  @@map("reprice_proposals")
}

// ---------------------------------------------------------------------------
// Sync engine
// ---------------------------------------------------------------------------

/// Raw inbound webhook payload, persisted by the ingress endpoint before any
/// work is enqueued. Ingress does nothing else: verify signature, write this
/// row, enqueue, return 200.
model WebhookEvent {
  id                String  @id @default(uuid(7))
  channelInstanceId String  @map("channel_instance_id")
  /// Platform topic, e.g. "orders/create".
  topic             String?
  /// Idempotency key. Non-null by design so the unique constraint actually
  /// fires; connectors fall back to a hash of the raw body when the platform
  /// supplies no event ID.
  externalEventId   String  @map("external_event_id")
  /// JSON-encoded request headers.
  headers           String
  /// Raw request body, byte-exact as received (signature verification depends on it).
  body              String

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  /// WebhookStatus: received | processed | failed | ignored
  status      String    @default("received")
  attempts    Int       @default(0)
  error       String?

  channelInstance ChannelInstance @relation(fields: [channelInstanceId], references: [id], onDelete: Cascade)

  @@unique([channelInstanceId, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Append-only audit log of every inbound/outbound/reconcile action.
model SyncEvent {
  id                String   @id @default(uuid(7))
  ts                DateTime @default(now())
  /// SyncDirection: inbound | outbound | reconcile
  direction         String
  channelInstanceId String?  @map("channel_instance_id")
  /// SyncEntityType: allocation | order | listing | inventory | channel
  entityType        String   @map("entity_type")
  entityId          String?  @map("entity_id")
  /// Connector operation, e.g. "updateQuantity", "pushListing", "fetchLiveState".
  operation         String?
  /// JSON-encoded request/response or webhook body. String, not Json — see header.
  payload           String?
  /// SyncOutcome: pending | ok | error | conflict
  outcome           String
  detail            String?
  durationMs        Int?     @map("duration_ms")

  channelInstance ChannelInstance? @relation(fields: [channelInstanceId], references: [id], onDelete: SetNull)

  @@index([ts])
  @@index([channelInstanceId, ts])
  @@index([entityType, entityId])
  @@index([outcome, ts])
  @@map("sync_events")
}

/// Human-actionable alert. Distinct from SyncEvent because an alert carries
/// acknowledge/resolve state and an inbox workflow; SyncEvent is immutable.
model Alert {
  id       String @id @default(uuid(7))
  /// AlertKind: oversell | sync_failure | reconcile_drift | auth_failure | invariant_violation | reprice_review
  kind     String
  /// AlertSeverity: info | warning | critical
  severity String @default("warning")

  /// Numeric mirror of `severity`, ascending by urgency: critical 0, warning 1,
  /// info 2.
  ///
  /// Ordering the inbox by the *string* sorts alphabetically — critical, info,
  /// warning — which floats routine info notices above real warnings. Postgres
  /// cannot express a custom order without raw SQL, which is banned in core
  /// (rule 1), so the order is stored rather than computed.
  ///
  /// Derived, and therefore only safe while one writer owns it: `AlertsService`
  /// is that writer, and a test asserts the two never disagree.
  severityRank Int @default(1) @map("severity_rank")

  channelInstanceId String? @map("channel_instance_id")
  inventoryItemId   String? @map("inventory_item_id")
  skuId             String? @map("sku_id")

  title   String
  detail  String?
  /// JSON-encoded structured context (expected vs actual, ids, ...).
  context String?

  /// AlertStatus: open | acknowledged | resolved
  status         String    @default("open")
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  channelInstance ChannelInstance? @relation(fields: [channelInstanceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  // Covers the inbox's own ordering: urgency first, then newest.
  @@index([status, severityRank, createdAt])
  @@index([kind, status])
  @@index([inventoryItemId])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Auth (TECHNICAL_DESIGN.md §8)
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid(7))
  username     String  @unique
  email        String? @unique
  displayName  String? @map("display_name")
  /// argon2id hash. Null for users provisioned by an external identity provider.
  passwordHash String? @map("password_hash")
  /// UserRole: admin | editor | viewer
  role         String  @default("viewer")
  /// AuthProviderKey: local | oidc
  provider     String  @default("local")
  /// OIDC subject claim; null for local users.
  externalId   String? @map("external_id")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  apiKeys  ApiKey[]

  @@unique([provider, externalId])
  @@index([role])
  @@map("users")
}

model Session {
  id        String @id @default(uuid(7))
  userId    String @map("user_id")
  /// SHA-256 of the session token. The raw token lives only in the cookie.
  tokenHash String @unique @map("token_hash")
  /// Per-session CSRF token (double-submit cookie pattern).
  csrfToken String @map("csrf_token")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id      String @id @default(uuid(7))
  name    String
  /// Public, non-secret lookup prefix; also shown in the UI to identify the key.
  prefix  String @unique
  /// argon2id hash of the secret half.
  keyHash String @map("key_hash")

  userId String? @map("user_id")
  /// UserRole the key acts as; may not exceed the owning user's role.
  role   String  @default("viewer")

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("api_keys")
}

/// Encrypted credential store (AES-256-GCM, master key from env/KMS).
/// Connectors receive decrypted secrets only inside Ctx, at call time.
model Credential {
  id  String @id @default(uuid(7))
  /// ChannelInstance.credentialRef points here.
  ref String @unique

  /// base64 AES-256-GCM ciphertext of the JSON secret bundle.
  ciphertext String
  /// base64 initialization vector.
  iv         String
  /// base64 GCM authentication tag.
  authTag    String @map("auth_tag")
  /// Master-key generation, so keys can be rotated without downtime.
  keyVersion Int    @default(1) @map("key_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credentials")
}

/// Instance-level key/value settings (first-run completion flag, defaults, ...).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
