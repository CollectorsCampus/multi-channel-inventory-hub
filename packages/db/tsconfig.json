{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS: NestJS runs as CJS and `require()`s this package. Keeping the
    // shared packages CJS avoids the ESM/CJS interop break at the app boundary.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"]
}
