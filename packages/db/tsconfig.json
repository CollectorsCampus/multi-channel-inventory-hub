{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS: NestJS runs as CJS and `require()`s this package. Keeping the
    // shared packages CJS avoids the ESM/CJS interop break at the app boundary.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  // Keep specs out of the built output, like every other package here. Beyond
  // being dead weight in a published dist, an emitted `dist/*.spec.js` is a
  // CommonJS test file that vitest 4 discovers and cannot run — vitest 4 is
  // ESM-only and rejects being `require()`d. vitest 3 excluded `dist/` by
  // default and hid this; vitest 4 does not.
  "exclude": ["src/**/*.spec.ts"]
}
